# Supabase & Google Sheets Integration Environment Variables
# Copy this file to .env and fill in real credentials from your Supabase and Google Apps Script deployments.

# -----------------------------------------------------------------------------
# CLIENT-EXPOSED VARIABLES (Vite builds these into the static client bundle)
# -----------------------------------------------------------------------------

# Supabase Project API URL (Found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous API Key (Anon Key with Row Level Security enforced)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Apps Script Webhook URL (Deployed Web App URL for one-way spreadsheet backup)
VITE_GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec

# Shared Secret Key for Webhook Authentication (Must match EXPECTED_WEBHOOK_SECRET in code.js)
VITE_GOOGLE_SHEETS_WEBHOOK_SECRET=rbe_sec_2026_wbk99

# Web Push Notification (VAPID Public Key untuk Browser HP)
VITE_VAPID_PUBLIC_KEY=BKyus5fW0GSrtsDr0Nu_zt4VkslA1R3zUuHuvStTucZ2IQDDFwmjc05N4vT8_-wg4AVfLqd-KaQCKMoDGbg86kI

# -----------------------------------------------------------------------------
# SERVER-SIDE SECRETS (Reference only - NOT used by client SPA)
# -----------------------------------------------------------------------------
# Web Push VAPID Private Key & Subject (Digunakan di Server/Edge Function pengirim push)
VAPID_PRIVATE_KEY=PrzT_j0Nn_nZL10RRVOipwu9zpSsSWHdBmv6gQIlRuE
VAPID_SUBJECT=mailto:admin@rumahbelajarenglish.com
