  view_file {
    absolute_path_uri: "file:///src/App.tsx"
    end_line: 250
    content: "import React, { useState, useEffect } from \'react\';\nimport {\n  mockStudents,\n  mockAttendanceRecords,\n  mockGalleryItems,\n  mockTuitionRecords,\n  courseBankAccounts,\n} from \'./data/mockData.ts\';\nimport { Student, TuitionRecord } from \'./types/index.ts\';\nimport { PinLockScreen } from \'./components/PinLockScreen.tsx\';\nimport { StudentProfileHeader } from \'./components/StudentProfileHeader.tsx\';\nimport { TabNavigation, ActiveTabType } from \'./components/TabNavigation.tsx\';\nimport { AttendanceTab } from \'./components/AttendanceTab.tsx\';\nimport { GalleryTab } from \'./components/GalleryTab.tsx\';\nimport { TuitionTab } from \'./components/TuitionTab.tsx\';\nimport { ShieldCheck, Lock, RotateCcw, Sparkles } from \'lucide-react\';\n\nexport default function App() {\n  const [currentStudent, setCurrentStudent] = useState<Student>(() => {\n    // Cek URL params jika ada ?token= atau ?id=\n    if (typeof window !== \'undefined\') {\n      const params = new URLSearchParams(window.location.search);\n      const token = params.get(\'token\');\n      if (token) {\n        const found = mockStudents.find((s) => s.token === token || s.id === token);\n        if (found) return found;\n      }\n    }\n    return mockStudents[0];\n  });\n\n  const [isUnlocked, setIsUnlocked] = useState<boolean>(() => {\n    // Cek status login sesi di browser\n    if (typeof window !== \'undefined\') {\n      return sessionStorage.getItem(`rbe_unlocked_${currentStudent.id}`) === \'true\';\n    }\n    return false;\n  });\n\n  const [activeTab, setActiveTab] = useState<ActiveTabType>(\'attendance\');\n\n  // State iuran dengan persistence sederhana di localStorage\n  const [tuitionRecords, setTuitionRecords] = useState<TuitionRecord[]>(() => {\n    if (typeof window !== \'undefined\') {\n      const saved = localStorage.getItem(`rbe_tuition_${currentStudent.id}`);\n      if (saved) {\n        try {\n          return JSON.parse(saved);\n        } catch {\n          // ignore error\n        }\n      }\n    }\n    return mockTuitionRecords.filter((t) => t.student_id === currentStudent.id);\n  });\n\n  // Filter absensi & galeri sesuai siswa aktif\n  const studentAttendance = mockAttendanceRecords.filter(\n    (a) => a.student_id === currentStudent.id\n  );\n  const studentGallery = mockGalleryItems.filter(\n    (g) => g.student_id === currentStudent.id\n  );\n\n  const handleUnlock = () => {\n    setIsUnlocked(true);\n    if (typeof window !== \'undefined\') {\n      sessionStorage.setItem(`rbe_unlocked_${currentStudent.id}`, \'true\');\n    }\n  };\n\n  const handleLock = () => {\n    setIsUnlocked(false);\n    if (typeof window !== \'undefined\') {\n      sessionStorage.removeItem(`rbe_unlocked_${currentStudent.id}`);\n    }\n  };\n\n  const handleSelectStudent = (st: Student) => {\n    setCurrentStudent(st);\n    const unlocked = sessionStorage.getItem(`rbe_unlocked_${st.id}`) === \'true\';\n    setIsUnlocked(unlocked);\n\n    const savedTuition = localStorage.getItem(`rbe_tuition_${st.id}`);\n    if (savedTuition) {\n      try {\n        setTuitionRecords(JSON.parse(savedTuition));\n        return;\n      } catch {\n        // fallback\n      }\n    }\n    setTuitionRecords(mockTuitionRecords.filter((t) => t.student_id === st.id));\n  };\n\n  const handleUpdateTuition = (updated: TuitionRecord) => {\n    setTuitionRecords((prev) => {\n      const next = prev.map((item) => (item.id === updated.id ? updated : item));\n      if (typeof window !== \'undefined\') {\n        localStorage.setItem(`rbe_tuition_${currentStudent.id}`, JSON.stringify(next));\n      }\n      return next;\n    });\n  };\n\n  const handleResetData = () => {\n    if (typeof window !== \'undefined\') {\n      localStorage.removeItem(`rbe_tuition_${currentStudent.id}`);\n    }\n    setTuitionRecords(mockTuitionRecords.filter((t) => t.student_id === currentStudent.id));\n    alert(\'Data status iuran berhasil dikembalikan ke kondisi awal.\');\n  };\n\n  // Jumlah tagihan yang belum dibayar\n  const unpaidCount = tuitionRecords.filter((t) => t.status === \'belum\').length;\n\n  // Jika belum dibuka dengan PIN, tampilkan layar kunci PIN\n  if (!isUnlocked) {\n    return (\n      <PinLockScreen\n        student={currentStudent}\n        onSuccess={handleUnlock}\n        availableStudents={mockStudents}\n        onSelectStudent={handleSelectStudent}\n      />\n    );\n  }\n\n  // Tampilan Utama Dasbor Wali Murid\n  return (\n    <div className=\"min-h-screen bg-slate-100/90 text-slate-900 pb-16\">\n      {/* Top Bar Ringkas Kontras Tinggi */}\n      <header className=\"sticky top-0 z-30 bg-blue-950 text-white shadow-md border-b-2 border-amber-400\">\n        <div className=\"max-w-2xl mx-auto px-4 py-3 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-9 h-9 rounded-xl bg-amber-400 text-blue-950 flex items-center justify-center font-black text-lg shadow-sm\">\n              R\n            </div>\n            <div>\n              <h1 className=\"text-base sm:text-lg font-black tracking-tight leading-tight\">\n                Rumah Belajar English\n              </h1>\n              <span className=\"text-[11px] font-semibold text-blue-200 block\">\n                Portal Resmi Wali Murid\n              </span>\n            </div>\n          </div>\n\n          {/* Tombol Kunci Halaman */}\n          <div className=\"flex items-center gap-2\">\n            <button\n              type=\"button\"\n              onClick={handleLock}\n              className=\"px-3 py-1.5 rounded-lg bg-blue-900 hover:bg-blue-800 text-white font-bold text-xs sm:text-sm flex items-center gap-1.5 border border-blue-700 transition-colors active:scale-95\"\n              title=\"Kunci kembali dengan PIN\"\n            >\n              <Lock className=\"w-4 h-4 text-amber-400\" />\n              <span className=\"hidden sm:inline\">Kunci Halaman</span>\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* Kontainer Utama Mobile-First */}\n      <main className=\"max-w-2xl mx-auto px-4 sm:px-6 pt-5 space-y-5\">\n        {/* Banner Selamat Datang Hangat */}\n        <div className=\"bg-white rounded-2xl p-4 border border-slate-200 shadow-2xs flex items-center justify-between\">\n          <div className=\"flex items-center gap-2.5 text-slate-800\">\n            <ShieldCheck className=\"w-5 h-5 text-emerald-600 shrink-0\" />\n            <p className=\"text-sm sm:text-base font-bold\">\n              Selamat datang, Wali dari <span className=\"text-blue-900\">{currentStudent.name}</span>\n            </p>\n          </div>\n          <span className=\"hidden sm:inline-block text-xs font-extrabold text-blue-900 bg-blue-50 px-2.5 py-1 rounded-full border border-blue-200\">\n            Terhubung\n          </span>\n        </div>\n\n        {/* 1. Profil Anak */}\n        <section aria-label=\"Profil Siswa\">\n          <StudentProfileHeader student={currentStudent} onLock={handleLock} />\n        </section>\n\n        {/* 2. Tab Navigasi (Absensi / Galeri / Iuran) */}\n        <section aria-label=\"Menu Informasi\">\n          <TabNavigation\n            activeTab={activeTab}\n            onChangeTab={setActiveTab}\n            unpaidCount={unpaidCount}\n          />\n        </section>\n\n        {/* Konten Tab Terpilih */}\n        <section className=\"pt-1\">\n          {activeTab === \'attendance\' && <AttendanceTab records={studentAttendance} />}\n          {activeTab === \'gallery\' && <GalleryTab items={studentGallery} />}\n          {activeTab === \'tuition\' && (\n            <TuitionTab\n              student={currentStudent}\n              records={tuitionRecords}\n              bankAccounts={courseBankAccounts}\n              onUpdateRecord={handleUpdateTuition}\n            />\n          )}\n        </section>\n\n        {/* Bar Bawah Ramah Orang Tua: Bantuan & Reset Uji Coba */}\n        <footer className=\"pt-6 border-t border-slate-300 text-center space-y-3 pb-8\">\n          <div className=\"bg-white rounded-2xl p-4 border border-slate-200 shadow-2xs space-y-1\">\n            <h4 className=\"font-extrabold text-slate-900 text-sm sm:text-base\">\n              Rumah Belajar English (Les Rumahan)\n            </h4>\n            <p className=\"text-xs sm:text-sm text-slate-600\">\n              Jl. Mawar Melati No. 12 \302\267 Kontak Pengajar Miss Sarah: 0812-3456-7890\n            </p>\n            <p className=\"text-xs text-slate-500 pt-1\">\n              Data siap dihubungkan langsung ke database Supabase.\n            </p>\n          </div>\n\n          {/* Opsi Uji Coba Developer / Orang Tua */}\n          <div className=\"flex flex-wrap items-center justify-center gap-2 text-xs text-slate-600\">\n            <button\n              type=\"button\"\n              onClick={handleResetData}\n              className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold transition-colors\"\n            >\n              <RotateCcw className=\"w-3.5 h-3.5\" />\n              <span>Reset Data Uji Coba</span>\n            </button>\n\n            <span className=\"text-slate-400\">\302\267</span>\n\n            <button\n              type=\"button\"\n              onClick={() => {\n                const next = mockStudents.find((s) => s.id !== currentStudent.id) || mockStudents[0];\n                handleSelectStudent(next);\n              }}\n              className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold transition-colors\"\n            >\n              <Sparkles className=\"w-3.5 h-3.5 text-blue-700\" />\n              <span>Ganti Contoh Siswa ({currentStudent.id === \'std_01\' ? \'Nadira\' : \'Kenzo\'})</span>\n            </button>\n          </div>\n        </footer>\n      </main>\n    </div>\n  );\n}\n"
    num_lines: 251
    num_bytes: 9579
    line_range_bytes: 9579
  }
}
