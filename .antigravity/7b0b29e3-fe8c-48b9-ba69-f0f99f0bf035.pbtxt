  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { Student } from \'../types/index.ts\';\nimport { Calendar, UserCheck, MessageCircle, LogOut } from \'lucide-react\';\n\ninterface StudentProfileHeaderProps {\n  student: Student;\n  onLock: () => void;\n}\n\nexport const StudentProfileHeader: React.FC<StudentProfileHeaderProps> = ({ student, onLock }) => {\n  const handleChatTeacher = () => {\n    const text = encodeURIComponent(\n      `Halo Miss Sarah, saya wali dari ${student.name}. Ingin menanyakan perkembangan belajar ananda.`\n    );\n    window.open(`https://wa.me/${student.teacher_whatsapp}?text=${text}`, \'_blank\');\n  };\n\n  return (\n    <div className=\"bg-white rounded-3xl border-2 border-slate-200 p-4 sm:p-6 shadow-sm\">\n      <div className=\"flex flex-col sm:flex-row items-center sm:items-start gap-4 sm:gap-6\">\n        {/* Foto Siswa dengan Bingkai Kontras Tinggi */}\n        <div className=\"relative shrink-0\">\n          <img\n            src={student.avatar_url}\n            alt={`Foto ananda ${student.name}`}\n            className=\"w-24 h-24 sm:w-28 sm:h-28 rounded-2xl object-cover border-4 border-amber-400 shadow-md\"\n            onError={(e) => {\n              // Fallback jika foto gagal load\n              (e.target as HTMLImageElement).src =\n                \'https://ui-avatars.com/api/?name=Kenzo+Alfarizi&background=0F2942&color=fff&size=128\';\n            }}\n          />\n          <div className=\"absolute -bottom-2 -right-2 bg-blue-900 text-white text-[11px] font-extrabold px-2.5 py-0.5 rounded-full border-2 border-white shadow\">\n            AKTIF\n          </div>\n        </div>\n\n        {/* Info Detail Siswa */}\n        <div className=\"flex-1 text-center sm:text-left\">\n          <div className=\"flex flex-wrap items-center justify-center sm:justify-start gap-2 mb-1\">\n            <span className=\"text-xs sm:text-sm font-bold text-amber-900 bg-amber-100 px-3 py-1 rounded-full border border-amber-300\">\n              {student.class_level}\n            </span>\n          </div>\n\n          <h2 className=\"text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight\">\n            {student.name}\n          </h2>\n          <p className=\"text-base text-slate-700 font-semibold mt-0.5\">\n            Nama Panggilan: <span className=\"text-blue-900 font-extrabold text-lg\">{student.nickname}</span>\n          </p>\n\n          {/* Jadwal Les & Pengajar */}\n          <div className=\"mt-3 pt-3 border-t border-slate-200 flex flex-col gap-2 text-sm sm:text-base text-slate-700\">\n            <div className=\"flex items-center justify-center sm:justify-start gap-2 text-slate-800\">\n              <Calendar className=\"w-5 h-5 text-blue-800 shrink-0\" />\n              <span><strong className=\"text-slate-900\">Jadwal:</strong> {student.schedule}</span>\n            </div>\n            <div className=\"flex items-center justify-center sm:justify-start gap-2 text-slate-800\">\n              <UserCheck className=\"w-5 h-5 text-emerald-700 shrink-0\" />\n              <span><strong className=\"text-slate-900\">Pengajar:</strong> {student.teacher_name}</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Tombol Aksi Cepat Bawah Profil */}\n      <div className=\"mt-4 pt-4 border-t border-slate-200 flex flex-col sm:flex-row gap-2.5 sm:gap-3\">\n        <button\n          type=\"button\"\n          onClick={handleChatTeacher}\n          className=\"flex-1 min-h-[48px] px-4 py-2.5 rounded-xl bg-emerald-700 hover:bg-emerald-800 active:bg-emerald-900 text-white font-bold text-base flex items-center justify-center gap-2 shadow-sm transition-colors active:scale-98\"\n        >\n          <MessageCircle className=\"w-5 h-5\" />\n          <span>Chat Miss Sarah (WhatsApp)</span>\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={onLock}\n          className=\"min-h-[48px] px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 active:bg-slate-300 text-slate-800 font-bold text-sm sm:text-base flex items-center justify-center gap-2 border border-slate-300 transition-colors active:scale-98\"\n          title=\"Kunci kembali layar untuk keamanan\"\n        >\n          <LogOut className=\"w-4 h-4 text-slate-600\" />\n          <span>Kunci PIN</span>\n        </button>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/StudentProfileHeader.tsx"
        }
        overwrite: true
      }
    }
