    end_line: 189
    content: "import { Student, AttendanceRecord, GalleryItem, TuitionRecord, BankAccount } from \'../types/index.ts\';\n\nexport const mockStudents: Student[] = [\n  {\n    id: \'std_01\',\n    token: \'kenzo-404\',\n    name: \'Kenzo Alfarizi Pratama\',\n    nickname: \'Kenzo\',\n    class_level: \'Primary English Explorer (Kelas 3 SD)\',\n    schedule: \'Selasa & Kamis \302\267 15.30 - 17.00 WIB\',\n    teacher_name: \'Miss Sarah Amalia, S.Pd.\',\n    teacher_whatsapp: \'6281234567890\',\n    pin: \'123456\',\n    avatar_url: \'/src/assets/images/student_avatar_kenzo_1794226596846.jpg\',\n  },\n  {\n    id: \'std_02\',\n    token: \'nadira-202\',\n    name: \'Nadira Alya Putri\',\n    nickname: \'Alya\',\n    class_level: \'Beginner Kids Phonics (Kelas 1 SD)\',\n    schedule: \'Senin & Rabu \302\267 14.00 - 15.30 WIB\',\n    teacher_name: \'Miss Sarah Amalia, S.Pd.\',\n    teacher_whatsapp: \'6281234567890\',\n    pin: \'654321\',\n    avatar_url: \'/src/assets/images/student_avatar_kenzo_1794226596846.jpg\',\n  }\n];\n\n// 8 Minggu Terakhir Absensi Kenzo\nexport const mockAttendanceRecords: AttendanceRecord[] = [\n  {\n    id: \'att_08\',\n    student_id: \'std_01\',\n    week_number: 8,\n    date: \'Kamis, 7 Nov 2024\',\n    topic: \'Vocabulary: Animal Friends & Simple Sentences\',\n    status: \'hadir\',\n    teacher_note: \'Kenzo sangat percaya diri saat membaca nama-nama hewan liar dalam bahasa Inggris. Tulisannya rapi dan mendapat bintang emas.\',\n  },\n  {\n    id: \'att_07\',\n    student_id: \'std_01\',\n    week_number: 7,\n    date: \'Selasa, 5 Nov 2024\',\n    topic: \'Listening & Speaking: My Daily Routine\',\n    status: \'hadir\',\n    teacher_note: \'Aktif merespon pertanyaan Miss Sarah tentang kegiatan bangun pagi dan sarapan. Pelafalan kata \"breakfast\" sudah sangat tepat.\',\n  },\n  {\n    id: \'att_06\',\n    student_id: \'std_01\',\n    week_number: 6,\n    date: \'Kamis, 31 Okt 2024\',\n    topic: \'Show & Tell Mini Project\',\n    status: \'hadir\',\n    teacher_note: \'Membawa gambar rumah dan berani maju presentasi di depan teman-teman sekelas. Sikap belajarnya luar biasa!\',\n  },\n  {\n    id: \'att_05\',\n    student_id: \'std_01\',\n    week_number: 5,\n    date: \'Selasa, 29 Okt 2024\',\n    topic: \'Grammar Fun: Singular & Plural Nouns\',\n    status: \'izin\',\n    teacher_note: \'Izin ada acara keluarga di luar kota. Materi modul halaman 24\342\200\22328 telah dikirimkan via WA untuk dipelajari mandiri.\',\n  },\n  {\n    id: \'att_04\',\n    student_id: \'std_01\',\n    week_number: 4,\n    date: \'Kamis, 24 Okt 2024\',\n    topic: \'Reading Corner: The Clever Monkey Story\',\n    status: \'hadir\',\n    teacher_note: \'Bisa menceritakan kembali inti cerita fabel dengan kalimat bahasa Inggris sederhana. Kosakatanya bertambah pesat.\',\n  },\n  {\n    id: \'att_03\',\n    student_id: \'std_01\',\n    week_number: 3,\n    date: \'Selasa, 22 Okt 2024\',\n    topic: \'Spelling Bee Practice & Colors\',\n    status: \'sakit\',\n    teacher_note: \'Sakit flu dan istirahat di rumah. Lekas sehat ananda Kenzo, materi ejaan kata sudah ditandai untuk sesi penguatan berikutnya.\',\n  },\n  {\n    id: \'att_02\',\n    student_id: \'std_01\',\n    week_number: 2,\n    date: \'Kamis, 17 Okt 2024\',\n    topic: \'Action Verbs: Run, Jump, Sing, Play\',\n    status: \'hadir\',\n    teacher_note: \'Sangat ceria saat games tebak gerakan (charades). Memahami arti 15 kata kerja baru dengan sangat cepat.\',\n  },\n  {\n    id: \'att_01\',\n    student_id: \'std_01\',\n    week_number: 1,\n    date: \'Selasa, 15 Okt 2024\',\n    topic: \'Introduction & Greetings in English\',\n    status: \'hadir\',\n    teacher_note: \'Awal pekan yang menyenangkan! Kenzo cepat akrab dengan kawan sekelas dan aktif menyapa dalam bahasa Inggris.\',\n  },\n];\n\n// Galeri Hasil Belajar & Kegiatan\nexport const mockGalleryItems: GalleryItem[] = [\n  {\n    id: \'gal_01\',\n    student_id: \'std_01\',\n    title: \'Lembar Kerja: My Animal Friends\',\n    date: \'7 November 2024\',\n    image_url: \'/src/assets/images/gallery_worksheet_handwriting_1794226596602.jpg\',\n    caption: \'Hasil tulisan tangan Kenzo pada tema hewan. Tulisannya sangat rapi, ejaan huruf lengkap tanpa coretan, dan mendapatkan stiker bintang emas dari Miss Sarah!\',\n    category: \'Hasil Belajar Mandiri\',\n  },\n  {\n    id: \'gal_02\',\n    student_id: \'std_01\',\n    title: \'Membaca Buku Cerita Bersama Teman\',\n    date: \'24 Oktober 2024\',\n    image_url: \'/src/assets/images/gallery_classroom_reading_1794226597787.jpg\',\n    caption: \'Sesi santai di sudut baca Rumah Belajar. Kenzo membaca buku dongeng bergambar dan saling bertukar peran tokoh bersama teman sekelas.\',\n    category: \'Kegiatan Kelas\',\n  },\n  {\n    id: \'gal_03\',\n    student_id: \'std_01\',\n    title: \'Presentasi Karya: My Adventure at Home\',\n    date: \'31 Oktober 2024\',\n    image_url: \'/src/assets/images/gallery_presentation_showandtell_1794226598069.jpg\',\n    caption: \'Momen berani dan membanggakan! Kenzo memegang poster hasil gambarnya sendiri sambil menceritakan aktivitas rumah dalam 5 kalimat bahasa Inggris.\',\n    category: \'Show and Tell\',\n  },\n];\n\n// 3 Bulan Terakhir Iuran\nexport const mockTuitionRecords: TuitionRecord[] = [\n  {\n    id: \'tui_03\',\n    student_id: \'std_01\',\n    period: \'November 2024\',\n    amount: 250000,\n    due_date: \'10 November 2024\',\n    status: \'belum\',\n  },\n  {\n    id: \'tui_02\',\n    student_id: \'std_01\',\n    period: \'Oktober 2024\',\n    amount: 250000,\n    due_date: \'10 Oktober 2024\',\n    status: \'menunggu\',\n    payment_date: \'9 Oktober 2024\',\n    payment_method: \'Transfer Bank BCA\',\n  },\n  {\n    id: \'tui_01\',\n    student_id: \'std_01\',\n    period: \'September 2024\',\n    amount: 250000,\n    due_date: \'10 September 2024\',\n    status: \'lunas\',\n    payment_date: \'5 September 2024\',\n    payment_method: \'Transfer Bank BCA\',\n  },\n];\n\n// Data Rekening Lembaga Les\nexport const courseBankAccounts: BankAccount[] = [\n  {\n    bank_name: \'BCA (Bank Central Asia)\',\n    account_number: \'8045192837\',\n    account_holder: \'SARAH AMALIA (RUMAH BELAJAR)\',\n    instructions: \'Mohon sertakan berita transfer: SPP [Nama Anak] [Bulan]\',\n  },\n  {\n    bank_name: \'Bank Mandiri\',\n    account_number: \'1370029485710\',\n    account_holder: \'SARAH AMALIA\',\n    instructions: \'Bisa transfer antar-bank atau via BI-Fast (biaya Rp 2.500)\',\n  },\n  {\n    bank_name: \'QRIS Semua Pembayaran\',\n    account_number: \'NMID: ID1020349581029\',\n    account_holder: \'RUMAH BELAJAR ENGLISH\',\n    instructions: \'Scan menggunakan GoPay, OVO, Dana, ShopeePay, atau Mobile Banking apa saja\',\n  },\n];\n"
