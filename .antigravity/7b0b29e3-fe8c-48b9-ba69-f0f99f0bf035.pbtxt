  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { GalleryItem } from \'../types/index.ts\';\nimport { ZoomIn, X, Calendar, Sparkles } from \'lucide-react\';\n\ninterface GalleryTabProps {\n  items: GalleryItem[];\n}\n\nexport const GalleryTab: React.FC<GalleryTabProps> = ({ items }) => {\n  const [selectedPhoto, setSelectedPhoto] = useState<GalleryItem | null>(null);\n\n  return (\n    <div className=\"space-y-4\">\n      {/* Keterangan Tab */}\n      <div className=\"bg-amber-50 rounded-2xl p-4 border border-amber-200\">\n        <div className=\"flex items-center gap-2\">\n          <Sparkles className=\"w-5 h-5 text-amber-700 shrink-0\" />\n          <h3 className=\"text-lg sm:text-xl font-extrabold text-amber-950\">\n            Galeri Hasil Belajar & Kegiatan Kelas\n          </h3>\n        </div>\n        <p className=\"text-sm sm:text-base text-amber-900 mt-1\">\n          Ketuk salah satu foto untuk memperbesar dan melihat lembar kerja tulisan tangan ananda dengan jelas.\n        </p>\n      </div>\n\n      {/* Grid Foto Kegiatan */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n        {items.map((item) => (\n          <div\n            key={item.id}\n            onClick={() => setSelectedPhoto(item)}\n            className=\"group bg-white rounded-2xl border-2 border-slate-200 overflow-hidden shadow-xs hover:border-blue-900 transition-all cursor-pointer flex flex-col\"\n            role=\"button\"\n            tabIndex={0}\n            onKeyDown={(e) => {\n              if (e.key === \'Enter\' || e.key === \' \') {\n                setSelectedPhoto(item);\n              }\n            }}\n          >\n            {/* Wadah Gambar dengan Aspek Rasio Nyaman */}\n            <div className=\"relative aspect-4/3 w-full bg-slate-100 overflow-hidden\">\n              <img\n                src={item.image_url}\n                alt={item.title}\n                className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\"\n                onError={(e) => {\n                  (e.target as HTMLImageElement).src =\n                    \'https://images.unsplash.com/photo-1503676260728-1c00da094a0b?auto=format&fit=crop&w=600&q=80\';\n                }}\n              />\n              <div className=\"absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center\">\n                <span className=\"bg-white/95 text-slate-900 font-extrabold text-sm px-3.5 py-1.5 rounded-full shadow-lg flex items-center gap-1.5\">\n                  <ZoomIn className=\"w-4 h-4 text-blue-900\" />\n                  Perbesar Foto\n                </span>\n              </div>\n              <div className=\"absolute top-3 left-3 bg-slate-900/80 backdrop-blur-xs text-white text-xs font-bold px-2.5 py-1 rounded-md\">\n                {item.category}\n              </div>\n            </div>\n\n            {/* Konten Keterangan */}\n            <div className=\"p-4 flex-1 flex flex-col justify-between\">\n              <div>\n                <h4 className=\"text-lg font-extrabold text-slate-900 leading-snug group-hover:text-blue-900 transition-colors\">\n                  {item.title}\n                </h4>\n                <p className=\"text-sm sm:text-base text-slate-700 font-medium mt-2 leading-relaxed\">\n                  {item.caption}\n                </p>\n              </div>\n\n              <div className=\"mt-3 pt-3 border-t border-slate-100 flex items-center justify-between text-xs sm:text-sm text-slate-600\">\n                <span className=\"flex items-center gap-1.5 font-semibold\">\n                  <Calendar className=\"w-4 h-4 text-slate-500\" />\n                  {item.date}\n                </span>\n                <span className=\"text-blue-900 font-bold flex items-center gap-1\">\n                  Lihat Detail \342\206\222\n                </span>\n              </div>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {/* Modal Lightbox Layar Penuh (Zoom Foto Ramah Lansia) */}\n      {selectedPhoto && (\n        <div\n          className=\"fixed inset-0 z-50 bg-black/85 backdrop-blur-sm flex flex-col items-center justify-center p-3 sm:p-6\"\n          onClick={() => setSelectedPhoto(null)}\n          role=\"dialog\"\n          aria-modal=\"true\"\n        >\n          <div\n            className=\"bg-white w-full max-w-2xl rounded-3xl overflow-hidden shadow-2xl flex flex-col max-h-[90vh]\"\n            onClick={(e) => e.stopPropagation()}\n          >\n            {/* Header Modal dengan Tombol Tutup Besar */}\n            <div className=\"flex items-center justify-between p-4 sm:p-5 border-b border-slate-200 bg-slate-50\">\n              <div>\n                <span className=\"text-xs font-bold text-blue-900 uppercase tracking-wider block\">\n                  {selectedPhoto.category} \302\267 {selectedPhoto.date}\n                </span>\n                <h3 className=\"text-xl sm:text-2xl font-extrabold text-slate-900\">\n                  {selectedPhoto.title}\n                </h3>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => setSelectedPhoto(null)}\n                className=\"w-12 h-12 rounded-full bg-slate-200 hover:bg-slate-300 text-slate-900 flex items-center justify-center transition-colors active:scale-95 focus:ring-4 focus:ring-slate-300\"\n                aria-label=\"Tutup foto\"\n              >\n                <X className=\"w-7 h-7\" />\n              </button>\n            </div>\n\n            {/* Foto Resolusi Penuh */}\n            <div className=\"overflow-y-auto p-4 sm:p-6 flex flex-col items-center\">\n              <img\n                src={selectedPhoto.image_url}\n                alt={selectedPhoto.title}\n                className=\"w-full max-h-[55vh] object-contain rounded-2xl border-2 border-slate-200 shadow-sm\"\n              />\n