xt-slate-600\'}`} />\n        <span>Galeri</span>\n      </button>\n\n      {/* Tab 3: Iuran */}\n      <button\n        type=\"button\"\n        onClick={() => onChangeTab(\'tuition\')}\n        className={`flex-1 min-h-[50px] sm:min-h-[54px] rounded-xl flex items-center justify-center gap-2 px-2 py-2 font-extrabold text-sm sm:text-base transition-all select-none relative active:scale-98 ${\n          activeTab === \'tuition\'\n            ? \'bg-blue-900 text-white shadow-md\'\n            : \'text-slate-700 hover:text-slate-900 hover:bg-white/60\'\n        }`}\n        role=\"tab\"\n        aria-selected={activeTab === \'tuition\'}\n      >\n        <WalletCards className={`w-5 h-5 shrink-0 ${activeTab === \'tuition\' ? \'text-amber-400\' : \'text-slate-600\'}`} />\n        <span>Iuran</span>\n        {unpaidCount > 0 && (\n          <span className=\"w-2.5 h-2.5 rounded-full bg-rose-500 ring-2 ring-white ml-0.5\" />\n        )}\n      </button>\n    </div>\n  );\n};\n"
