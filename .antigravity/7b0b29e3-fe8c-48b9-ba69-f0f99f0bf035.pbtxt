            }
            lines {
              text: "  - Font Sans yang bulat dan sangat mudah dibaca: *Plus Jakarta Sans* / font modern sistem dengan rendering crisp."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - Judul besar (`text-2xl` hingga `text-3xl font-bold`)."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - Teks instruksi minimum `text-lg` (18px) untuk mencegah ketegangan mata bagi orang tua."
