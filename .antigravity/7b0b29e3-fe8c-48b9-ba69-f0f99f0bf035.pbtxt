  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { CalendarCheck, Image, WalletCards, ChevronRight, CheckCircle2 } from \'lucide-react\';\n\nexport type ActiveTabType = \'attendance\' | \'gallery\' | \'tuition\';\n\ninterface TabNavigationProps {\n  activeTab: ActiveTabType;\n  onChangeTab: (tab: ActiveTabType) => void;\n  unpaidCount: number;\n}\n\nexport const TabNavigation: React.FC<TabNavigationProps> = ({\n  activeTab,\n  onChangeTab,\n  unpaidCount,\n}) => {\n  const tabs = [\n    {\n      id: \'attendance\' as ActiveTabType,\n      number: \'1\',\n      title: \'Absensi & Catatan Guru\',\n      subtitle: \'Riwayat 8 pekan, kehadiran & evaluasi belajar\',\n      icon: CalendarCheck,\n    },\n    {\n      id: \'gallery\' as ActiveTabType,\n      number: \'2\',\n      title: \'Galeri Karya & Foto Kelas\',\n      subtitle: \'Lembar kerja tulisan tangan & kegiatan seru\',\n      icon: Image,\n    },\n    {\n      id: \'tuition\' as ActiveTabType,\n      number: \'3\',\n      title: \'Iuran Les & Konfirmasi Bayar\',\n      subtitle: \'Status 3 bulan, nomor rekening & kirim bukti\',\n      icon: WalletCards,\n      badge: unpaidCount > 0 ? `${unpaidCount} Perlu Bayar` : undefined,\n    },\n  ];\n\n  return (\n    <div className=\"space-y-4\">\n      {/* 1. Menu Vertikal Menumpuk ke Bawah (Tombol Sangat Besar & Mudah Dipencet) */}\n      <div className=\"space-y-3\">\n        <div className=\"flex items-center justify-between\">\n          <label className=\"text-sm sm:text-base font-extrabold text-slate-800\">\n            Pilih Informasi yang Ingin Dilihat:\n          </label>\n          <span className=\"text-xs font-bold text-slate-500\">\n            Ketuk tombol besar di bawah\n          </span>\n        </div>\n\n        {tabs.map((tab) => {\n          const Icon = tab.icon;\n          const isActive = activeTab === tab.id;\n\n          return (\n            <button\n              key={tab.id}\n              type=\"button\"\n              onClick={() => {\n                onChangeTab(tab.id);\n                // Scroll lembut ke area konten\n                const targetEl = document.getElementById(\'tab-content-area\');\n                if (targetEl) {\n                  targetEl.scrollIntoView({ behavior: \'smooth\', block: \'start\' });\n                }\n              }}\n              className={`w-full min-h-[72px] sm:min-h-[78px] p-4 sm:p-5 rounded-2xl border-3 flex items-center justify-between gap-4 text-left transition-all active:scale-98 select-none shadow-sm ${\n                isActive\n                  ? \'bg-blue-950 border-amber-400 text-white shadow-md ring-4 ring-blue-900/20\'\n                  : \'bg-white hover:bg-slate-50 border-slate-300 text-slate-900 hover:border-blue-900\'\n              }`}\n              role=\"tab\"\n              aria-selected={isActive}\n            >\n              <div className=\"flex items-center gap-3.5 sm:gap-4 flex-1\">\n                {/* Lingkaran Ikon Besar */}\n                <div\n                  className={`w-13 h-13 sm:w-14 sm:h-14 rounded-2xl flex items-center justify-center shrink-0 transition-colors ${\n                    isActive\n                      ? \'bg-amber-400 text-blue-950 font-black\'\n                      : \'bg-blue-100 text-blue-900\'\n                  }`}\n                >\n                  <Icon className=\"w-7 h-7 sm:w-8 sm:h-8\" />\n                </div>\n\n                <div className=\"flex-1\">\n                  <div className=\"flex flex-wrap items-center gap-2\">\n                    <span\n                      className={`text-lg sm:text-xl font-black leading-snug ${\n                        isActive ? \'text-white\' : \'text-slate-900\'\n                      }`}\n                    >\n                      {tab.title}\n                    </span>\n                    {tab.badge && (\n                      <span className=\"bg-rose-500 text-white text-xs font-extrabold px-2.5 py-0.5 rounded-full shadow-xs\">\n                        {tab.badge}\n                      </span>\n                    )}\n                  </div>\n                  <p\n                    className={`text-xs sm:text-sm font-medium mt-0.5 leading-tight ${\n                      isActive ? \'text-blue-200\' : \'text-slate-600\'\n                    }`}\n                  >\n                    {tab.subtitle}\n                  </p>\n                </div>\n              </div>\n\n              {/* Status Indicator / Panah */}\n              <div className=\"shrink-0\">\n                {isActive ? (\n                  <span className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-amber-400 text-blue-950 font-black text-xs sm:text-sm\">\n                    <CheckCircle2 className=\"w-4 h-4 text-blue-950\" />\n                    <span>Aktif</span>\n                  </span>\n                ) : (\n                  <div className=\"w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-500\">\n                    <ChevronRight className=\"w-6 h-6\" />\n                  </div>\n                )}\n              </div>\n            </button>\n          );\n        })}\n      </div>\n\n      {/* 2. Fixed Bottom Tab Bar di Layar HP (Agar Selalu Mudah Dipencet Tanpa Scroll ke Atas) */}\n      <nav\n        className=\"fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t-2 border-slate-300 shadow-[0_-4px_20px_rgba(0,0,0,0.12)] pb-safe\"\n        aria-label=\"Navigasi Bawah Layar\"\n      >\n        <div className=\"max-w-2xl mx-auto grid grid-cols-3 h-20 items-stretch px-2\">\n          {tabs.map((tab) => {\n            const Icon = tab.icon;\n            const isActive = activeTab === tab.id;\n\n            return (\n              <button\n                key={tab.id}\n                type=\"button\"\n                onClick={() => {\n                  onChangeTab(tab.id);\n                  const targetEl = document.getElementById(\'tab-content-area\');\n                  if (targetEl) {\n                    targetEl.scrollIntoView({ behavior: \'smooth\', block: \'start\' });\n                  }\n                }}\n                className={`flex flex-col items-center justify-center py-1 transition-all select-none active:scale-95 relative ${\n                  isActive\n                    ? \'text-blue-950 font-black bg-amber-50/70 border-t-4 border-blue-950\'\n                    : \'text-slate-600 hover:text-slate-900 font-bold\'\n                }`}\n                aria-selected={isActive}\n              >\n                <div className=\"relative\">\n                  <Icon\n                    className={`w-7 h-7 transition-transform ${\n                      isActive ? \'scale-110 text-blue-950\' : \'text-slate-500\'\n                    }`}\n                  />\n                  {tab.badge && (\n                    <span className=\"absolute -top-1 -right-2 w-3 h-3 rounded-full bg-rose-500 ring-2 ring-white\" />\n                  )}\n                </div>\n                <span\n                  className={`text-xs sm:text-sm tracking-tight mt-1 truncate max-w-full px-1 ${\n                    isActive ? \'font-black text-blue-950\' : \'font-extrabold text-slate-700\'\n                  }`}\n                >\n                  {tab.id === \'attendance\' ? \'Absensi\' : tab.id === \'gallery\' ? \'Galeri\' : \'Iuran SPP\'}\n                </span>\n              </button>\n            );\n          })}\n        </div>\n      </nav>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/TabNavigation.tsx"
        }
        overwrite: true
      }
    }
