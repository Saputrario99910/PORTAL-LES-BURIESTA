  view_file {
    absolute_path_uri: "file:///src/types/index.ts"
    end_line: 54
    content: "export type AttendanceStatus = \'hadir\' | \'izin\' | \'sakit\' | \'alpa\';\nexport type TuitionStatus = \'lunas\' | \'menunggu\' | \'belum\';\n\nexport interface Student {\n  id: string;\n  token: string;\n  name: string;\n  nickname: string;\n  class_level: string;\n  schedule: string;\n  teacher_name: string;\n  teacher_whatsapp: string;\n  pin: string;\n  avatar_url: string;\n}\n\nexport interface AttendanceRecord {\n  id: string;\n  student_id: string;\n  week_number: number;\n  date: string;\n  topic: string;\n  status: AttendanceStatus;\n  teacher_note: string;\n}\n\nexport interface GalleryItem {\n  id: string;\n  student_id: string;\n  title: string;\n  date: string;\n  image_url: string;\n  caption: string;\n  category: string;\n}\n\nexport interface TuitionRecord {\n  id: string;\n  student_id: string;\n  period: string; // e.g. \"November 2024\"\n  amount: number;\n  due_date: string;\n  status: TuitionStatus;\n  payment_date?: string;\n  payment_method?: string;\n  proof_url?: string;\n}\n\nexport interface BankAccount {\n  bank_name: string;\n  account_number: string;\n  account_holder: string;\n  instructions: string;\n}\n"
    num_lines: 55
    num_bytes: 1085
    line_range_bytes: 1085
  }
}
