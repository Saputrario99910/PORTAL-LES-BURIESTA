    content: "        </div>\n      </header>\n\n      {/* Konten Utama Desktop (Lebar & Terstruktur) */}\n      <main className=\"max-w-7xl mx-auto px-4 sm:px-6 pt-6 space-y-6\">\n        {/* Baris Judul & Tombol Upload Galeri + Isi Absensi di Kanan Atas */}\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-5 rounded-2xl border-2 border-slate-200 shadow-xs\">\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <ShieldCheck className=\"w-6 h-6 text-emerald-700\" />\n              <h2 className=\"text-2xl sm:text-3xl font-black text-slate-900 tracking-tight\">\n                Menunggu Verifikasi Pembayaran\n              </h2>\n            </div>\n            <p className=\"text-sm text-slate-600 font-medium mt-1\">\n              Periksa dan validasi bukti transfer iuran SPP siswa sebelum diperbarui otomatis ke portal wali.\n            </p>\n          </div>\n\n          {/* Tombol Aksi Kanan Atas: Upload Galeri & Isi Absensi Kelas (Menumpuk Rapi) */}\n          <div className=\"flex flex-col gap-2.5 w-full sm:w-auto shrink-0\">\n            {/* 1. Tombol Upload Galeri */}\n            <button\n              type=\"button\"\n              onClick={() => setShowUploadModal(true)}\n              className=\"w-full sm:w-auto px-5 py-2.5 sm:py-3 rounded-xl bg-blue-900 hover:bg-blue-950 active:bg-blue-800 text-white font-extrabold text-sm sm:text-base flex items-center justify-center gap-2.5 shadow-md transition-all active:scale-95\"\n            >\n              <PlusCircle className=\"w-5 h-5 text-amber-400\" />\n              <span>Upload Foto Kegiatan</span>\n            </button>\n\n            {/* 2. Tombol Isi Absensi Kelas (Di Bawah Tombol Upload Galeri) */}\n            <button\n              type=\"button\"\n              onClick={() => setShowAttendanceModal(true)}\n              className=\"w-full sm:w-auto px-5 py-2.5 sm:py-3 rounded-xl bg-emerald-700 hover:bg-emerald-800 active:bg-emerald-900 text-white font-extrabold text-sm sm:text-base flex items-center justify-center gap-2.5 shadow-md transition-all active:scale-95\"\n            >\n              <ClipboardCheck className=\"w-5 h-5 text-emerald-200\" />\n              <span>Isi Absensi Kelas</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Metrik Cepat Sederhana */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n          <div className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-2xs flex items-center gap-3\">\n            <div className=\"w-12 h-12 rounded-xl bg-amber-100 text-amber-900 flex items-center justify-center\">\n              <Clock className=\"w-6 h-6 text-amber-700\" />\n            </div>\n            <div>\n              <span className=\"text-xs font-bold text-slate-500 uppercase\">Menunggu Verifikasi</span>\n              <div className=\"text-2xl font-black text-amber-800 tabular-nums\">\n                {waitingCount} Siswa\n              </div>\n            </div>\n          </div>\n\n          <div className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-2xs flex items-center gap-3\">\n            <div className=\"w-12 h-12 rounded-xl bg-emerald-100 text-emerald-900 flex items-center justify-center\">\n              <CheckCircle2 className=\"w-6 h-6 text-emerald-700\" />\n            </div>\n            <div>\n              <span className=\"text-xs font-bold text-slate-500 uppercase\">Telah Diverifikasi</span>\n              <div className=\"text-2xl font-black text-emerald-800 tabular-nums\">\n                {verifiedCount} Siswa\n              </div>\n            </div>\n          </div>\n\n          <div className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-2xs flex items-center gap-3\">\n            <div className=\"w-12 h-12 rounded-xl bg-blue-100 text-blue-900 flex items-center justify-center\">\n              <DollarSign className=\"w-6 h-6 text-blue-800\" />\n            </div>\n            <div>\n              <span className=\"text-xs font-bold text-slate-500 uppercase\">Total Dana Terverifikasi</span>\n              <div className=\"text-2xl font-black text-blue-950 tabular-nums\">\n                {formatRupiah(totalVerifiedAmount)}\n              </div>\n            </div>\n          </div>\n        </div>"
    num_lines: 472
    num_bytes: 21198
    line_range_bytes: 4219
  }
}
