  user_input {
    user_response: "<clarifying-answers>\nQ: Bagaimana akses navigasi menuju Dashboard Admin yang diinginkan?\nA: Tautan tombol Admin di header dan path /admin\nQ: Bagaimana tampilan data pembayaran setelah tombol Verifikasi ditekan?\nA: Berubah jadi badge Lunas dengan opsi filter tab status\nQ: Apakah perlu opsi kirim notifikasi lunas ke WhatsApp wali murid?\nA: Cukup ubah status tabel menjadi Lunas\n</clarifying-answers>"
    items {
      text: "<clarifying-answers>\nQ: Bagaimana akses navigasi menuju Dashboard Admin yang diinginkan?\nA: Tautan tombol Admin di header dan path /admin\nQ: Bagaimana tampilan data pembayaran setelah tombol Verifikasi ditekan?\nA: Berubah jadi badge Lunas dengan opsi filter tab status\nQ: Apakah perlu opsi kirim notifikasi lunas ke WhatsApp wali murid?\nA: Cukup ubah status tabel menjadi Lunas\n</clarifying-answers>"
    }
  }
}
