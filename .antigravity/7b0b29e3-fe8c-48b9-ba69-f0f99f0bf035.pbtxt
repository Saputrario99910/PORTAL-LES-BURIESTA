      id: "call_1248412189119023494"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { AdminPaymentVerification } from \'../../data/adminMockData.ts\';\\nimport { X, CheckCircle, CreditCard, Calendar, User, FileText } from \'lucide-react\';\\n\\ninterface ProofModalProps {\\n  payment: AdminPaymentVerification;\\n  onClose: () => void;\\n  onVerify: (id: string) => void;\\n}\\n\\nexport const ProofModal: React.FC<ProofModalProps> = ({ payment, onClose, onVerify }) => {\\n  const formatRupiah = (amount: number) => {\\n    return new Intl.NumberFormat(\'id-ID\', {\\n      style: \'currency\',\\n      currency: \'IDR\',\\n      maximumFractionDigits: 0,\\n    }).format(amount);\\n  };\\n\\n  return (\\n    <div\\n      className=\\\"fixed inset-0 z-50 bg-black/75 backdrop-blur-xs flex items-center justify-center p-4 overflow-y-auto\\\"\\n      onClick={onClose}\\n      role=\\\"dialog\\\"\\n      aria-modal=\\\"true\\\"\\n    >\\n      <div\\n        className=\\\"bg-white rounded-3xl max-w-xl w-full overflow-hidden shadow-2xl border-2 border-slate-200 my-8 flex flex-col max-h-[92vh]\\\"\\n        onClick={(e) => e.stopPropagation()}\\n      >\\n        {/* Header Modal */}\\n        <div className=\\\"flex items-center justify-between p-5 border-b border-slate-200 bg-slate-50\\\">\\n          <div>\\n            <span className=\\\"text-xs font-bold text-slate-500 uppercase tracking-wider block\\\">\\n              Bukti Transfer Siswa\\n            </span>\\n            <h3 className=\\\"text-xl font-black text-slate-900 leading-tight\\\">\\n              {payment.student_name}\\n            </h3>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onClose}\\n            className=\\\"w-10 h-10 rounded-full bg-slate-200 hover:bg-slate-300 text-slate-700 flex items-center justify-center transition-colors\\\"\\n            aria-label=\\\"Tutup pratinjau\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        {/* Isi Modal */}\\n        <div className=\\\"p-5 sm:p-6 overflow-y-auto space-y-4\\\">\\n          {/* Ringkasan Data Pembayaran */}\\n          <div className=\\\"grid grid-cols-2 gap-3 bg-slate-50 p-4 rounded-2xl border border-slate-200 text-sm\\\">\\n            <div>\\n              <span className=\\\"text-xs text-slate-500 block font-semibold\\\">Kelas:</span>\\n              <span className=\\\"font-extrabold text-slate-900\\\">{payment.student_class}</span>\\n            </div>\\n            <div>\\n              <span className=\\\"text-xs text-slate-500 block font-semibold\\\">Bulan Tagihan:</span>\\n              <span className=\\\"font-extrabold text-blue-900\\\">{payment.billing_month}</span>\\n            </div>\\n            <div>\\n              <span className=\\\"text-xs text-slate-500 block font-semibold\\\">Nominal Tagihan:</span>\\n              <span className=\\\"font-black text-emerald-800 text-base font-mono\\\">\\n                {formatRupiah(payment.amount)}\\n              </span>\\n            </div>\\n            <div>\\n              <span className=\\\"text-xs text-slate-500 block font-semibold\\\">Bank Pengirim:</span>\\n              <span className=\\\"font-bold text-slate-800\\\">\\n                {payment.sender_bank} ({payment.sender_account_name})\\n              </span>\\n            </div>\\n          </div>\\n\\n          {/* Pratinjau Gambar Struk */}\\n          <div className=\\\"flex flex-col items-center\\\">\\n            <span className=\\\"text-xs font-bold text-slate-600 self-start mb-2 flex items-center gap-1.5\\\">\\n              <FileText className=\\\"w-4 h-4 text-blue-900\\\" />\\n              Tampilan Gambar Struk Transfer:\\n            </span>\\n            <div className=\\\"w-full max-w-sm aspect-2/3 bg-slate-100 rounded-2xl overflow-hidden border-2 border-slate-300 shadow-inner flex items-center justify-center relative\\\">\\n              <img\\n                src={payment.proof_image_url}\\n                alt={`Struk pembayaran ${payment.student_name}`}\\n                className=\\\"w-full h-full object-cover\\\"\\n                onError={(e) => {\\n                  // Fallback jika placeholder offline\\n                  (e.target as HTMLImageElement).src =\\n                    \'https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?auto=format&fit=crop&w=400&q=80\';\\n                }}\\n              />\\n              <div className=\\\"absolute bottom-2 left-2 right-2 bg-black/60 backdrop-blur-xs text-white text-[11px] p-2 rounded-xl text-center font-medium\\\">\\n                Diunggah pada: {payment.upload_date}\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Footer Tombol Aksi */}\\n        <div className=\\\"p-4 border-t border-slate-200 bg-slate-50 flex flex-col sm:flex-row items-center justify-between gap-3\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onClose}\\n            className=\\\"w-full sm:w-auto px-5 py-2.5 rounded-xl bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold text-sm\\\"\\n          >\\n            Tutup\\n          </button>\\n\\n          {payment.status === \'menunggu\' ? (\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => {\\n                onVerify(payment.id);\\n                onClose();\\n              }}\\n              className=\\\"w-full sm:w-auto px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-black text-sm flex items-center justify-center gap-2 shadow-md transition-colors\\\"\\n            >\\n              <CheckCircle className=\\\"w-4 h-4\\\" />\\n              <span>Verifikasi Pembayaran Ini</span>\\n            </button>\\n          ) : (\\n            <span className=\\\"text-xs font-extrabold text-emerald-700 bg-emerald-100 px-3 py-1.5 rounded-xl border border-emerald-300 flex items-center gap-1.5\\\">\\n              <CheckCircle className=\\\"w-4 h-4\\\" />\\n              Telah Diverifikasi Lunas\\n            </span>\\n          )}\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create ProofModal component for viewing student transfer slip placeholder image\", \"Overwrite\":true, \"TargetFile\":\"/src/components/admin/ProofModal.tsx\", \"toolAction\":\"Writing component\", \"toolSummary\":\"Create ProofModal component\"}"
      thinking_signature: "\022\240\005\n\235\005\001i\024}\023\337\';\325\346\226G9\035x\215\356\231t\357eh\nz\212\366\377A\001h\r\220\\\302\323\216\317\334\201\243\361\344l3\331\242\262^\001\342\002\305k\333\360\2369F\213\321Gw\203\'T\036\317oy\006#\3258Yn\023\260\300\257\301H\fk\304V|b\277\311O\234\223/\a\346\\l\260FZ.\262\341\004\321W\375\b\237\237\371\223\350G\r\034\337x\a\033\370\024Jn=k\301\tKnPaD\027\001\330\03028\207\360\000\277\'\t\355\r\201\315M*R\367y[\326\035]j\f\226\213:Rv\ti\256\3432\272\213\3645\224O\264\026\006\241_\202\226\253J^\2256\232\316W\vlJ=\251\367\002\033vO\313\032\177\201A\214\352\227FJ\234\376&\217\236\017:!\264\246!\017\310\224\351L\036*x\220\246$oK;C\"n\003\315\227\021\345\177\366\210\327\256\275\220\357\024\a\364\371/\300\021\254\246\273\302Z#\302\345O\265\275\256\266\020|a\3469\227\306[N\246d\214\343\373\267#\350\005\345\3018\275\224<\256H|+T\034\027\262\016\267\335&\333\363\215\002\035\024\330K\b5\r\3117u\323\265))\351\314\335\273}\325F\020\241\327]r\354\3612P\322\333\342Fz#\033hg\r\241\315]\203\271\223\260\026\023\220N=\023\332\tY\350&\206]d\262\"i&hY\brO\033\245\236\210\267\351\250*\002\356\214\341\270\000\223ro\277\320\aa\203\311\316\035W\351\214sp\316\025\232\247|k\244\221ze\365\376\3774\001Eu\3631\232\026\327`\347c\201\2705\203\374\350s\375\321\021\000\370#\026\263\036\373>\222?\347cy\264\354\315_F\340[\033\341b\261f\353\356\337{\362\323\275\313)\361\017\373\351\0334\374\364{7YW\215u\342\3221X\347\207e\257uK\320X\025\003f\355`\345\177\230a\241V\207\224\371\317\302S\270\243<>8\254D\275\003Q\326H\263P?\217=\244\363\b\272\244\271\363\214\030i\255\177\223s\336\214cC\210\225\377\236w\274\363\260\302\325\256?\227(\346\000\343\307\244\257L\210\306;n\241\311YT\354\3657\360\361\'\361\357{\315\320~\b\364Lny\374\246qh\357fo\025A\240\322\201\224\302|\361\vJ\235\304\226\331IG\374\3156\266\'9f\245Q\256/\326\352\340Tr\005\334\365\037Y\314\0252\t`j\006\005\356\000/\022\252N2<\337\372t"
