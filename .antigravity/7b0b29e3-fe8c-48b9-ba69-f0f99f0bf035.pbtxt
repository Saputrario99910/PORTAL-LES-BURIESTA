  planner_response {
    thinking: "**Constructing the Dashboard**\n\nI\'m currently focused on building the `AdminDashboard.tsx` file. I\'ve started structuring the desktop layout with `max-w-7xl mx-auto px-6 py-8`. Next, I will create the header, including the title \"Dashboard Pemilik Lembaga \302\267 Rumah Belajar English\" and the \"\342\206\220 Kembali ke Portal Wali\" breadcrumb (or a button).\n\n\n"
    tool_calls {
      id: "call_13935484698061782497"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport {\\n  AdminPaymentVerification,\\n  initialAdminPayments,\\n  adminStudentOptions,\\n} from \'../../data/adminMockData.ts\';\\nimport { ProofModal } from \'./ProofModal.tsx\';\\nimport { UploadGalleryModal } from \'./UploadGalleryModal.tsx\';\\nimport {\\n  CheckCircle2,\\n  Clock,\\n  Eye,\\n  PlusCircle,\\n  ArrowLeft,\\n  ShieldCheck,\\n  Search,\\n  Filter,\\n  Check,\\n  DollarSign,\\n  Users,\\n} from \'lucide-react\';\\n\\ninterface AdminDashboardProps {\\n  onBackToPortal: () => void;\\n}\\n\\nexport const AdminDashboard: React.FC<AdminDashboardProps> = ({ onBackToPortal }) => {\\n  const [payments, setPayments] = useState<AdminPaymentVerification[]>(initialAdminPayments);\\n  const [activeFilter, setActiveFilter] = useState<\'menunggu\' | \'lunas\' | \'semua\'>(\'menunggu\');\\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\\n  const [selectedProofPayment, setSelectedProofPayment] = useState<AdminPaymentVerification | null>(\\n    null\\n  );\\n  const [showUploadModal, setShowUploadModal] = useState<boolean>(false);\\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\\n\\n  const formatRupiah = (amount: number) => {\\n    return new Intl.NumberFormat(\'id-ID\', {\\n      style: \'currency\',\\n      currency: \'IDR\',\\n      maximumFractionDigits: 0,\\n    }).format(amount);\\n  };\\n\\n  const handleVerifyPayment = (id: string) => {\\n    setPayments((prev) =>\\n      prev.map((item) =>\\n        item.id === id\\n          ? {\\n              ...item,\\n              status: \'lunas\',\\n              verified_at: new Date().toLocaleTimeString(\'id-ID\', {\\n                hour: \'2-digit\',\\n                minute: \'2-digit\',\\n              }),\\n            }\\n          : item\\n      )\\n    );\\n    showToast(\'Pembayaran berhasil diverifikasi menjadi Lunas.\');\\n  };\\n\\n  const showToast = (message: string) => {\\n    setToastMessage(message);\\n    setTimeout(() => {\\n      setToastMessage(null);\\n    }, 3500);\\n  };\\n\\n  const handleUploadSuccess = (data: {\\n    studentId: string;\\n    studentName: string;\\n    caption: string;\\n    imageUrl: string;\\n  }) => {\\n    setShowUploadModal(false);\\n    showToast(`Foto berhasil diunggah untuk siswa ${data.studentName}.`);\\n  };\\n\\n  // Filter pembayaran\\n  const filteredPayments = payments.filter((item) => {\\n    const matchFilter =\\n      activeFilter === \'semua\' ? true : item.status === activeFilter;\\n    const matchSearch =\\n      item.student_name.toLowerCase().includes(searchQuery.toLowerCase()) ||\\n      item.student_class.toLowerCase().includes(searchQuery.toLowerCase()) ||\\n      item.billing_month.toLowerCase().includes(searchQuery.toLowerCase());\\n    return matchFilter && matchSearch;\\n  });\\n\\n  const waitingCount = payments.filter((p) => p.status === \'menunggu\').length;\\n  const verifiedCount = payments.filter((p) => p.status === \'lunas\').length;\\n  const totalVerifiedAmount = payments\\n    .filter((p) => p.status === \'lunas\')\\n    .reduce((acc, curr) => acc + curr.amount, 0);\\n\\n  return (\\n    <div className=\\\"min-h-screen bg-slate-100 text-slate-900 pb-20\\\">\\n      {/* Top Bar Admin Desktop Lebar */}\\n      <header className=\\\"sticky top-0 z-30 bg-slate-900 text-white border-b-2 border-emerald-500 shadow-md\\\">\\n        <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 py-3.5 flex items-center justify-between\\\">\\n          <div className=\\\"flex items-center gap-3\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onBackToPortal}\\n              className=\\\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs sm:text-sm font-bold border border-slate-700 transition-colors\\\"\\n            >\\n              <ArrowLeft className=\\\"w-4 h-4\\\" />\\n              <span>Kembali ke Portal Wali</span>\\n            </button>\\n\\n            <span className=\\\"text-slate-600\\\">|</span>\\n\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <div className=\\\"w-8 h-8 rounded-lg bg-emerald-500 text-slate-950 font-black flex items-center justify-center text-base\\\">\\n                A\\n              </div>\\n              <div>\\n                <h1 className=\\\"text-sm sm:text-base font-black leading-tight\\\">\\n                  Dashboard Pemilik Lembaga\\n                </h1>\\n                <span className=\\\"text-[11px] text-emerald-400 font-semibold block\\\">\\n                  Rumah Belajar English \302\267 Panel Administrasi\\n                </span>\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* Quick Info Pengajar */}\\n          <div className=\\\"hidden sm:flex items-center gap-2 text-xs text-slate-300 font-medium\\\">\\n            <span className=\\\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\\\"></span>\\n            <span>Miss Sarah (Admin Utama)</span>\\n          </div>\\n        </div>\\n      </header>\\n\\n      {/* Konten Utama Desktop (Lebar & Terstruktur) */}\\n      <main className=\\\"max-w-7xl mx-auto px-4 sm:px-6 pt-6 space-y-6\\\">\\n        {/* Baris Judul & Tombol Upload Galeri di Kanan Atas */}\\n        <div className=\\\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-5 rounded-2xl border-2 border-slate-200 shadow-xs\\\">\\n          <div>\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <ShieldCheck className=\\\"w-6 h-6 text-emerald-700\\\" />\\n              <h2 className=\\\"text-2xl sm:text-3xl font-black text-slate-900 tracking-tight\\\">\\n                Menunggu Verifikasi Pembayaran\\n              </h2>\\n            </div>\\n            <p className=\\\"text-sm text-slate-600 font-medium mt-1\\\">\\n              Periksa dan validasi bukti transfer iuran SPP siswa sebelum diperbarui otomatis ke portal wali.\\n            </p>\\n          </div>\\n\\n          {/* 2. Tombol Upload Galeri (Di Kanan Atas Sesuai Instruksi) */}\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setShowUploadModal(true)}\\n            className=\\\"w-full sm:w-auto px-5 py-3 rounded-xl bg-blue-900 hover:bg-blue-950 active:bg-blue-800 text-white font-extrabold text-sm sm:text-base flex items-center justify-center gap-2.5 shadow-md transition-all active:scale-95\\\"\\n          >\\n            <PlusCircle className=\\\"w-5 h-5 text-amber-400\\\" />\\n            <span>Upload Foto Kegiatan</span>\\n          </button>\\n        </div>\\n\\n        {/* Metrik Cepat Sederhana */}\\n        <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-4\\\">\\n          <div className=\\\"bg-white p-4 rounded-xl border border-slate-200 shadow-2xs flex items-center gap-3\\\">\\n            <div className=\\\"w-12 h-12 rounded-xl bg-amber-100 text-amber-900 flex items-center justify-center\\\">\\n              <Clock className=\\\"w-6 h-6 text-amber-700\\\" />\\n            </div>\\n            <div>\\n              <span className=\\\"text-xs font-bold text-slate-500 uppercase\\\">Menunggu Verifikasi</span>\\n              <div className=\\\"text-2xl font-black text-amber-800 tabular-nums\\\">\\n                {waitingCount} Siswa\\n              </div>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"bg-white p-4 rounded-xl border border-slate-200 shadow-2xs flex items-center gap-3\\\">\\n            <div className=\\\"w-12 h-12 rounded-xl bg-emerald-100 text-emerald-900 flex items-center justify-center\\\">\\n              <CheckCircle2 className=\\\"w-6 h-6 text-emerald-700\\\" />\\n            </div>\\n            <div>\\n              <span className=\\\"text-xs font-bold text-slate-500 uppercase\\\">Telah Diverifikasi</span>\\n              <div className=\\\"text-2xl font-black text-emerald-800 tabular-nums\\\">\\n                {verifiedCount} Siswa\\n              </div>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"bg-white p-4 rounded-xl border border-slate-200 shadow-2xs flex items-center gap-3\\\">\\n            <div className=\\\"w-12 h-12 rounded-xl bg-blue-100 text-blue-900 flex items-center justify-center\\\">\\n              <DollarSign className=\\\"w-6 h-6 text-blue-800\\\" />\\n            </div>\\n            <div>\\n              <span className=\\\"text-xs font-bold text-slate-500 uppercase\\\">Total Dana Terverifikasi</span>\\n              <div className=\\\"text-2xl font-black text-blue-950 tabular-nums\\\">\\n                {formatRupiah(totalVerifiedAmount)}\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Area Tabel & Kontrol Filter */}\\n        <div className=\\\"bg-white rounded-2xl border-2 border-slate-200 shadow-xs overflow-hidden\\\">\\n          {/* Filter Baris & Pencarian */}\\n          <div className=\\\"p-4 border-b border-slate-200 bg-slate-50 flex flex-col md:flex-row items-center justify-between gap-3\\\">\\n            {/* Filter Tabs */}\\n            <div className=\\\"flex items-center gap-1.5 w-full md:w-auto\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setActiveFilter(\'menunggu\')}\\n                className={`px-4 py-2 rounded-xl text-xs sm:text-sm font-extrabold transition-colors flex items-center gap-1.5 ${\\n                  activeFilter === \'menunggu\'\\n                    ? \'bg-amber-500 text-slate-950 shadow-xs\'\\n                    : \'bg-white text-slate-700 border border-slate-200 hover:bg-slate-100\'\\n                }`}\\n              >\\n                <span>Menunggu Verifikasi</span>\\n                <span className=\\\"bg-amber-950 text-white text-[11px] px-1.5 py-0.2 rounded-full font-bold\\\">\\n                  {waitingCount}\\n                </span>\\n              </button>\\n\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setActiveFilter(\'lunas\')}\\n                className={`px-4 py-2 rounded-xl text-xs sm:text-sm font-extrabold transition-colors flex items-center gap-1.5 ${\\n                  activeFilter === \'lunas\'\\n                    ? \'bg-emerald-600 text-white shadow-xs\'\\n                    : \'bg-white text-slate-700 border border-slate-200 hover:bg-slate-100\'\\n                }`}\\n              >\\n                <span>Sudah Lunas</span>\\n                <span className=\\\"bg-emerald-950 text-white text-[11px] px-1.5 py-0.2 rounded-full font-bold\\\">\\n                  {verifiedCount}\\n                </span>\\n              </button>\\n\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setActiveFilter(\'semua\')}\\n                className={`px-4 py-2 rounded-xl text-xs sm:text-sm font-extrabold transition-colors ${\\n                  activeFilter === \'semua\'\\n                    ? \'bg-slate-900 text-white shadow-xs\'\\n                    : \'bg-white text-slate-700 border border-slate-200 hover:bg-slate-100\'\\n                }`}\\n              >\\n                Semua ({payments.length})\\n              </button>\\n            </div>\\n\\n            {/* Input Pencarian */}\\n            <div className=\\\"relative w-full md:w-72\\\">\\n              <Search className=\\\"w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2\\\" />\\n              <input\\n                type=\\\"text\\\"\\n                placeholder=\\\"Cari siswa atau bulan...\\\"\\n                value={searchQuery}\\n                onChange={(e) => setSearchQuery(e.target.value)}\\n                className=\\\"w-full pl-9 pr-3 py-2 rounded-xl border border-slate-300 text-xs sm:text-sm font-medium focus:border-blue-900 focus:ring-1 focus:ring-blue-900 outline-hidden bg-white\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          {/* Tabel Desktop Bersih & Rapi */}\\n          <div className=\\\"overflow-x-auto\\\">\\n            <table className=\\\"w-full text-left border-collapse\\\">\\n              <thead>\\n                <tr className=\\\"border-b border-slate-200 bg-slate-100/70 text-[11px] sm:text-xs font-black text-slate-600 uppercase tracking-wider\\\">\\n                  <th className=\\\"py-3.5 px-4\\\">Nama Siswa</th>\\n                  <th className=\\\"py-3.5 px-4\\\">Kelas</th>\\n                  <th className=\\\"py-3.5 px-4\\\">Bulan Tagihan</th>\\n                  <th className=\\\"py-3.5 px-4 text-right\\\">Nominal</th>\\n                  <th className=\\\"py-3.5 px-4\\\">Tanggal Upload</th>\\n                  <th className=\\\"py-3.5 px-4 text-center\\\">Status</th>\\n                  <th className=\\\"py-3.5 px-4 text-center min-w-[200px]\\\">Aksi</th>\\n                </tr>\\n              </thead>\\n              <tbody className=\\\"divide-y divide-slate-200 text-sm font-medium text-slate-800\\\">\\n                {filteredPayments.length === 0 ? (\\n                  <tr>\\n                    <td colSpan={7} className=\\\"py-12 text-center text-slate-500 font-semibold\\\">\\n                      Tidak ada data pembayaran yang sesuai dengan filter atau kata kunci.\\n                    </td>\\n                  </tr>\\n                ) : (\\n                  filteredPayments.map((item) => (\\n                    <tr\\n                      key={item.id}\\n                      className=\\\"hover:bg-slate-50/80 transition-colors\\\"\\n                    >\\n                      {/* Nama Siswa */}\\n                      <td className=\\\"py-3.5 px-4\\\">\\n                        <div className=\\\"font-extrabold text-slate-900 text-sm\\\">\\n                          {item.student_name}\\n                        </div>\\n                        <div className=\\\"text-xs text-slate-500 font-semibold\\\">\\n                          Panggilan: <span className=\\\"text-blue-900\\\">{item.nickname}</span>\\n                        </div>\\n                      </td>\\n\\n                      {/* Kelas */}\\n                      <td className=\\\"py-3.5 px-4\\\">\\n                        <span className=\\\"text-xs font-bold text-slate-700 bg-slate-100 px-2.5 py-1 rounded-md\\\">\\n                          {item.student_class}\\n                        </span>\\n                      </td>\\n\\n                      {/* Bulan Tagihan */}\\n                      <td className=\\\"py-3.5 px-4 font-bold text-blue-950\\\">\\n                        {item.billing_month}\\n                      </td>\\n\\n                      {/* Nominal */}\\n                      <td className=\\\"py-3.5 px-4 text-right font-black font-mono tabular-nums text-slate-900 text-base\\\">\\n                        {formatRupiah(item.amount)}\\n                      </td>\\n\\n                      {/* Tanggal Upload */}\\n                      <td className=\\\"py-3.5 px-4 text-xs font-semibold text-slate-600\\\">\\n                        {item.upload_date}\\n                        <div className=\\\"text-[11px] text-slate-400 font-normal\\\">\\n                          {item.sender_bank}\\n                        </div>\\n                      </td>\\n\\n                      {/* Status */}\\n                      <td className=\\\"py-3.5 px-4 text-center\\\">\\n                        {item.status === \'lunas\' ? (\\n                          <span className=\\\"inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-emerald-100 text-emerald-800 border border-emerald-300 font-extrabold text-xs\\\">\\n                            <Check className=\\\"w-3.5 h-3.5\\\" />\\n                            <span>Lunas</span>\\n                          </span>\\n                        ) : (\\n                          <span className=\\\"inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-amber-100 text-amber-900 border border-amber-300 font-extrabold text-xs\\\">\\n                            <Clock className=\\\"w-3.5 h-3.5\\\" />\\n                            <span>Menunggu</span>\\n                          </span>\\n                        )}\\n                      </td>\\n\\n                      {/* Kolom Aksi: 2 Tombol (Lihat Bukti & Verifikasi Hijau) */}\\n                      <td className=\\\"py-3.5 px-4\\\">\\n                        <div className=\\\"flex items-center justify-center gap-2\\\">\\n                          {/* Tombol 1: Lihat Bukti */}\\n                          <button\\n                            type=\\\"button\\\"\\n                            onClick={() => setSelectedProofPayment(item)}\\n                            className=\\\"px-3 py-1.5 rounded-lg bg-white hover:bg-blue-50 text-blue-900 font-bold text-xs border border-blue-300 flex items-center gap-1 shadow-2xs transition-colors\\\"\\n                            title=\\\"Buka gambar bukti transfer\\\"\\n                          >\\n                            <Eye className=\\\"w-3.5 h-3.5 text-blue-800\\\" />\\n                            <span>Lihat Bukti</span>\\n                          </button>\\n\\n                          {/* Tombol 2: Verifikasi (Warna Hijau Sesuai Perintah) */}\\n                          {item.status === \'menunggu\' ? (\\n                            <button\\n                              type=\\\"button\\\"\\n                              onClick={() => handleVerifyPayment(item.id)}\\n                              className=\\\"px-3.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-black text-xs flex items-center gap-1 shadow-sm transition-all active:scale-95\\\"\\n                              title=\\\"Tandai pembayaran sebagai Lunas\\\"\\n                            >\\n                              <Check className=\\\"w-3.5 h-3.5\\\" />\\n                              <span>Verifikasi</span>\\n                            </button>\\n                          ) : (\\n                            <span className=\\\"text-xs font-bold text-slate-400 py-1.5 px-2\\\">\\n                              \342\234\223 Terverifikasi\\n                            </span>\\n                          )}\\n                        </div>\\n                      </td>\\n                    </tr>\\n                  ))\\n                )}\\n              </tbody>\\n            </table>\\n          </div>\\n\\n          {/* Footer Tabel */}\\n          <div className=\\\"p-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between text-xs text-slate-500 font-medium\\\">\\n            <span>\\n              Menampilkan {filteredPayments.length} dari {payments.length} transaksi pembayaran\\n            </span>\\n            <span>Rumah Belajar English \302\267 Sistem Pembayaran Mandiri</span>\\n          </div>\\n        </div>\\n      </main>\\n\\n      {/* Modal 1: Lihat Bukti Transfer */}\\n      {selectedProofPayment && (\\n        <ProofModal\\n          payment={selectedProofPayment}\\n          onClose={() => setSelectedProofPayment(null)}\\n          onVerify={handleVerifyPayment}\\n        />\\n      )}\\n\\n      {/* Modal 2: Upload Foto Kegiatan Galeri */}\\n      {showUploadModal && (\\n        <UploadGalleryModal\\n          students={adminStudentOptions}\\n          onClose={() => setShowUploadModal(false)}\\n          onSuccess={handleUploadSuccess}\\n        />\\n      )}\\n\\n      {/* Notifikasi Toast Mengambang Sesuai Instruksi */}\\n      {toastMessage && (\\n        <div className=\\\"fixed bottom-6 right-6 z-50 bg-slate-900 text-white px-5 py-3 rounded-2xl shadow-2xl border-2 border-emerald-400 flex items-center gap-3 animate-bounce\\\">\\n          <div className=\\\"w-6 h-6 rounded-full bg-emerald-500 text-slate-950 flex items-center justify-center font-bold\\\">\\n            <Check className=\\\"w-4 h-4\\\" />\\n          </div>\\n          <span className=\\\"text-sm font-extrabold\\\">{toastMessage}</span>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create AdminDashboard component with payment verification table, proof modal, and gallery upload button\", \"Overwrite\":true, \"TargetFile\":\"/src/components/admin/AdminDashboard.tsx\", \"toolAction\":\"Writing component\", \"toolSummary\":\"Create AdminDashboard component\"}"
      thinking_signature: "\022\220\v\n\215\v\001i\024}\023\335 8\241\005j\035@\336k\210\307\304&\361\3015\321\b(3\267\375\222\267\340\311(|\af\263\317\316\315xK\0224;\344\244\fy[\2765\031\006\277\316W\025\366\034v\'\315\301r\244\305\376w\277N\020+\v\207\005\336\262\232\023\242\323\275L \360b6\213^pq\371k\277;\241r\325\231\321g\031\034@\377\016{\r\a\304\237\312lmbl\t2\311se\342\200*\036T\266\217\322tHC\246\320Y\247\207\277\246\367\201\v\231\302\260\214\247\306\203\375h\027\236}\337\243\374\215Hws\036YIS\235{\032\372\247\302\251h{x\222\332\317\337\331d\020\347\213`\016\367kj\220[\"|\326\241\242\377H\375d\205\224@\264+{\006\365/C{\373vt\241z\027zUP\256U\364)\235\t\233\377w\344\316h{\245\275Am\273\221\006\210\230P;\r\253\207z.!\376\242\251\265J\233\227\017\263U?G/\240\'\205:\0172W\033*\f\355\035\310o\346~\"s\250_\023A\277\262\241%\355\316\313\235\351\340\234\222)\023\344\303V\037\304\312\363\263\177d\332\212\324i,\v\273\250\222\2462\374\352\365\022\262# \340\205D[\237\201L\314\276\304 \357\212\205kI\0018\331zQ;\004\266d\003\343C\212\336y9xq?9\263D\217[\361:b\373\276\206\177\204-\2245\333\236\217d\004\261d\221$\324\230\357\301P6\b\331.\254\370\260SbD\001\fC.pu!i\362\273\366c\340\360\252\357\267\263i=\352\217\n\023^\337\207\223]\033%\274\261\016 H\221b\351U\304\237\274J\373\377\033\271,\306,\364Z\302\324\212\370\002j`\340\027L\213?I\033^\n\276\361k\207s*\245\b\277\245\374\301\206\363j\330,\023S\256\273\261oB\'\377\0013f\276jc?\377\000\035G\a\317\263\310\275\217\317\307\267&\2742\v\031c|.\243\a4\224u\177<y\036GfH\305\0310\214\221I:\352RJY&\3262\037\304xa\375i\r\236@\r\001K8s\272\334\217~\016d\272\253\342\347\226i\006\033\026\260\234\302\211\210\vQz\260\277k\233\1774\202\222\263\314\033\315\271\255\'^\373o\034\f\337\223@ \316L<\001\344\242\243\343\211r\351#%\032iOR[\271e\207\320|\351\rL\362f\253\206\233\311t\363H\370b\340G\350T\306\272\026\362Bh\335o\213\377+\b\252\005DmO2S6T\025D\263l\366t\'Cn\375;x\2261_\355B\221\372\340{dt-Eh\304\306\247\001)\206\354Ss#\n\352\343Oj-E\242\362\200\252\325\221Ze\377\216Adq\330\022\247i\237\223,\314\376@\0273b\276\3658\313\300\336\355~\227\357\023\242H\351!\317&\205\022i\321\t\364>\v\025<\365\bc\362\363\224\035\232\031z@\354\241n\217>\257D\207\205y\230\247\355\255\263\202-H\356\367\237\024\030L8&\222q&*-\310\222&\350Y\215wpt\367QT\214\034)H0\213\354*\254\353\vq\\3a0LA\215\230\317\3555\245\b\324\226\365\211\352%\205,\020\300\350o\325xC\026IR\243l\215\2749\277s\301\377\f\221#cA+\224{\033\270\"\257\235K\333\376pq5\371\034\307\353\334Q\232/&\275\344\302\220A\352t\310\273J\"\030FJj[y0|\347L\341]\370\253\360w+\230\202\216\304\026\000\f\322\0277$^A\231\"c\341GJ\222\001\355?\335l\200\344\343b\323\372\361\fS\374\326Y\223jO\215\251v\031\037\f\235\245M\272\016V\252\315\332\370\306\312\ny\353\316\330u\236\242C\266\035?\247\303a\035\001b\322\374\367S\334\326\207\000\243\22489\023\332\'*&6!\244\371\210\357\003i\204n@\362\336\220D\017\275\343\030_\304\025\215#\273\244\235\n\302\210\030:\332\006\327\260\031\024\tl\303\273\333<$}\240R\352\020\265\375\004:5K\331\347-\365\313\313\316\314\300\323o\003\346\342\373\326\r\276\350\307\005\260d\221\275:S\240\0301\322\355.a&R\a\022\246K\037/\372\256\316w\264k8\037\262\244\016=\303\313`\232\223m\334*\271\320h\205\272W\353B\300W\256\320\353\211\342s\361\216M\230\323O;\307\257\237\\\274\266w\236w\350\257\311\314^\320\030\341\016\031d\266\326\\\322\234\231\250IbX\321P\241\244qr<6t\253\022q\373\271\003\306`\v\370\322\031\237N\226\337T\037\357:\325P6\271g\365\242@\246n\226B\320\332\214\264=\237\224\276\274\\X\030\337#\303\210M\215K\263\022\177G\253\026\322\370\203\0165-\036_a\224\246\345\300\016\373l\020\263\350\030\260bv\362\251\356\307\361\225X\267:\215\356iE\356\000\306\324X}\350\212\357\362\2130\353i\244h\232\272J?*\371`h\276Ft\317\250Z\373\242\346\366\374\313.\250l\310\n\v\270:^%\324\211/U\212}#\317\262\'\275\023\266\005\326\245\005\3406\237$M\356\277E\303\314&W\371Aa\227\204m\261v\314&\273C\300Z\302U\254\332\245)K\256\233\212\276\273\313,\332.\005_c\203\334\324\363\371\033\236