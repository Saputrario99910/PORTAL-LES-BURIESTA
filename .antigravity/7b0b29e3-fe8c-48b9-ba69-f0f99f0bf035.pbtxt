            lines {
              text: "### Planned Execution Steps"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Konfigurasi Identitas & Metadata**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Perbarui `index.html` dan `metadata.json` dengan judul \"Portal Wali Murid - Rumah Belajar English\"."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Data Mock & Service Helper**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Buat `src/data/mockData.ts` dan tipe TypeScript yang siap dipindahkan ke Supabase Client (`@supabase/supabase-js`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **Komponen Layar Kunci PIN**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Buat `src/components/PinLockScreen.tsx` dengan display 6 digit, tombol virtual keypad besar, umpan balik getar/animasi, dan pesan bantuan."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "4. **Komponen Header & Profil Siswa**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Tampilan profil ramah mata dengan nama ananda, foto, info pengajar, dan tombol logout/ganti siswa."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "5. **Komponen Tab Absensi**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Kartu 8 pekan dengan visual status yang kontras tinggi dan catatan guru yang membesarkan hati orang tua."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "6. **Komponen Tab Galeri Karya**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
