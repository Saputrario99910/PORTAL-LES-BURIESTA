            }
            lines {
              text: "### 3. Key Product Decisions & Trade-Offs"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- **Decision 1: Keypad Telepon Virtual On-Screen**:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - *Chosen Approach*: Menyediakan tombol angka 0-9 langsung di layar alih-alih mengandalkan keyboard sistem bawaan HP."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - *Why*: Orang tua lanjut usia sering kesulitan dengan keyboard HP yang kadang menutupi layar, tombol kecil, atau keyboard berganti ke huruf secara tidak sengaja."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - *Alternative Considered*: Standard HTML number input ditolak karena tampilan keyboard berbeda-beda antar Android dan iPhone."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "- **Decision 2: Navigasi Satu Halaman Tab Bersih (Tanpa Menu Hamburger)**:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - *Chosen Approach*: 3 tombol tab besar di bagian atas kartu informasi."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - *Why*: Orang tua sering tersesat jika ada drawer menu hamburger atau menu bertingkat."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "- **Decision 3: Integrasi Salin Rekening & WhatsApp Direct Link**:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - *Chosen Approach*: Tombol \"Salin Nomor\" dengan format otomatis dan tombol \"Kirim Bukti ke WhatsApp\" dengan format `https://wa.me/...`."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - *Why*: Kebiasaan orang tua di Indonesia adalah menyelesaikan urusan lewat WhatsApp."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "- **Decision 1: Client-Side Routing `/admin`**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Chosen Approach*: Sinkronisasi URL pathname (`window.location.pathname`) dan event `popstate`/`pushState` tanpa reload penuh."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Why*: Memenuhi spesifikasi tepat \"route /admin\" di Vite SPA tanpa memerlukan server rendering rumit."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Decision 2: Pemisahan Data Dummy Siswa & Verifikasi**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Chosen Approach*: Membuat `src/data/adminMockData.ts` berisi 10 siswa Indonesia (Kenzo Alfarizi, Nadira Alya, Dimas Prasetyo, Raisa Zahra, Fadhil Ramadhan, Annisa Maharani, Bagas Wicaksono, Tiara Andini, Rian Saputra, Clarissa Aurelia) lengkap dengan detail tagihan dan URL struk transfer."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Why*: Menjaga isolasi kode dan kesiapan integrasi backend Supabase."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
