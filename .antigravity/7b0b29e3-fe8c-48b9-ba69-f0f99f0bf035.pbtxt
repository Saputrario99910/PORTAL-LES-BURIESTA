              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Palette**: Slate-900 typography, Slate-100/200 borders, Emerald-600/700 for verification buttons, Amber-500 accents matching Rumah Belajar English branding."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Typography**: Tabular numerals for rupiah amounts, clean sans headings (`font-bold text-slate-900`), single-line cell alignments with generous padding (`py-3.5 px-4`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
