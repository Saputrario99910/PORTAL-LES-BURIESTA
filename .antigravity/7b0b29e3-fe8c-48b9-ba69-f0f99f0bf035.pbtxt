            }
            lines {
              text: "8. **Verifikasi Build & Linter**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Pastikan bebas error TypeScript, lolos `compile_applet` dan `lint_applet`, dan uji responsivitas mobile."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
