            lines {
              text: "#### Visual Identity & Theme"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Aesthetic Direction**: Hangat, ramah keluarga, terpercaya, dan sangat mengutamakan keterbacaan (Accessibility-First & Senior-Friendly)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Color Palette**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - Dominan Kanvas: Putih gading bersih (`#F8FAFC` & `#FFFFFF`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - Warna Primer / Brand: Deep Navy (`#0F2942`) memberikan kontras teks tajam (rasio kontras > 7:1 terhadap latar)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - Warna Aksen / CTA: Vivid Amber Gold (`#F59E0B` & `#D97706`) untuk tombol bayar dan tindakan utama."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - Warna Status Terang: Hijau Daun (`#15803D`) untuk Lunas/Hadir, Oranye Hangat (`#C2410C`) untuk Menunggu, Merah Tegas (`#B91C1C`) untuk Belum Bayar."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Typography & Hierarchy**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - Font Sans yang bulat dan sangat mudah dibaca: *Plus Jakarta Sans* / font modern sistem dengan rendering crisp."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - Judul besar (`text-2xl` hingga `text-3xl font-bold`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - Teks instruksi minimum `text-lg` (18px) untuk mencegah ketegangan mata bagi orang tua."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Micro-Interactions**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - Tombol keypad menekan dengan respons taktil visual (`active:scale-95 transition-transform`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - Animasi transisi tab yang lembut dan instan."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
