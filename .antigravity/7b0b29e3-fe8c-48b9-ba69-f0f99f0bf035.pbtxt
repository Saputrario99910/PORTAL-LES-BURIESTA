      thinking_signature: "\022\231\b\n\226\b\001i\024}\023\033g\305\354r\336\327q1_\375\006\020\236E\371+\200\a\v\273Pa\204\221J\266\236-*y\375\'\002\371\023\365\257t\201\017\225\346\315\241\231\257\267J\346\261\321\033F\237>\251\206cN5\327Vy\r\b\311\366\247\035h\032\366\037i9\322\373\250\300\f\001\332%\353u\261\237_\352\365\023|\350nDu\364\275\344\303\f\ts\217\033\331\025\253\257q\273\277\257\315\026\'\343\217\242W\334\036)\377\005 N\244\202\002\321\274\"$\271\227Y\336$M!vFB\nt\v\343\344\266\227\247\254\275\025::\250w%# [<w\365\343b\244\233\314\221\306\322\021\252\002\341\021\276x\220\366\030o\177\217z/\273\231L3\322\227\343nd\002\352\311\017_%\f\242\021\330\036\231\213\354C\\#\273\326\"\000\357S\026\234\367\357\226\316\314\216\313$\023\374(\371y\226Q\246\343)\361y\205-4\'\'\222\023p\310\212l\277\aq\227\005\206\246[=VVu\217\242\342\351\231\0026Y\206\005\237\271\246w-\336e\237\222\001\275\216\352\3529\264w\320\317\342J\026\340\206\213\373\374f 8\347Z\256\b7\220\247P\217\373\032iG+[W2\347K\321\324\0063\251\017\250HuK\363LS$Z{\305\346\253o\314\0336N\324\315<[\v\222\v &\247\357\rE\360\374,X\304F\260P\231\342\331\035\351\337\020\177K\235)7\217\003\217\326\343\323:y\267\250\343,y\222\340UV\375\336\253\264\023\302\371,\340\235\00586\023]1w\246\316\2142.\226$\274\000J\027qA\374\271\366\256p\216\375\376\032\344\262\022\276\362\312\212^e\263\221\310\306\006\257\312\360\316\333\026\201\3135\221q\273By\305\357J)\006Gt$-T\343\265]S)\304\344\\\367-?\001xK[2\'\237\234\3035\356\241\377\023\347\243\017I\244\317\212\r\341\205\373\261\022\016\277O\002b\327\362\211X\360,\307\360dy\245\002Z\3522\344\237\t\202\274hlR\222\316K~`\237\207h\240\314}\266q\245]_\237\201V\035K\263`\273\255\310\211F.\036\235\351^\244U}B\363q\341\376x\366y\356\327\340\331\203\202M\203x\211\3665\214gd\025\a\327\234\321PT\ttzh\003\021\020\232JT\365-\337\2661\024\331_\351M\vz\302\365\331i):2Tj\307,@\275.\000g\336\374\rK\337k\233\316Q7\336\352\300\223\003c\251[\331\340G\352j\253\')O\334\365V\242G\033p\203\025\232(\