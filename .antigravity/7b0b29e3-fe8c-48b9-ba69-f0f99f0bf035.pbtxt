  view_file {
    absolute_path_uri: "file:///src/components/LearningPlanTab.tsx"
    end_line: 97
    content: "import React from \'react\';\nimport { LearningPlanItem } from \'../types/index.ts\';\nimport { BookOpen, CheckCircle2, Clock, Target, Calendar } from \'lucide-react\';\n\ninterface LearningPlanTabProps {\n  plans: LearningPlanItem[];\n}\n\nexport const LearningPlanTab: React.FC<LearningPlanTabProps> = ({ plans }) => {\n  return (\n    <div className=\"space-y-4\">\n      {/* Keterangan Pembuka */}\n      <div className=\"bg-indigo-50 rounded-2xl p-4 border border-indigo-200\">\n        <div className=\"flex items-center gap-2\">\n          <BookOpen className=\"w-5 h-5 text-indigo-800 shrink-0\" />\n          <h3 className=\"text-lg sm:text-xl font-extrabold text-indigo-950\">\n            Rencana & Silabus Belajar (4 Pertemuan)\n          </h3>\n        </div>\n        <p className=\"text-sm sm:text-base text-indigo-900 mt-1\">\n          Pantau materi yang telah dipelajari ananda serta persiapan topik untuk pertemuan mendatang.\n        </p>\n      </div>\n\n      {/* Daftar 4 Pertemuan */}\n      <div className=\"space-y-3.5\">\n        {plans.map((item) => {\n          const isDone = item.status === \'selesai\';\n\n          return (\n            <div\n              key={item.id}\n              className={`bg-white rounded-2xl border-2 p-4 sm:p-5 shadow-xs transition-all ${\n                isDone\n                  ? \'border-slate-200 hover:border-emerald-400\'\n                  : \'border-blue-300 bg-blue-50/20 hover:border-blue-600\'\n              }`}\n            >\n              {/* Baris Atas: Pertemuan ke-X, Tanggal, dan Status */}\n              <div className=\"flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-slate-200\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"bg-slate-900 text-white font-extrabold text-xs sm:text-sm px-3 py-1 rounded-lg\">\n                    Pertemuan {item.meeting_number}\n                  </span>\n                  <div className=\"flex items-center gap-1.5 text-slate-800 font-bold text-sm sm:text-base\">\n                    <Calendar className=\"w-4 h-4 text-blue-900\" />\n                    <span>{item.date}</span>\n                  </div>\n                </div>\n\n                {/* Badge Status Kontras Tinggi */}\n                <div>\n                  {isDone ? (\n                    <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-emerald-100 border-2 border-emerald-500 text-emerald-950 font-extrabold text-xs sm:text-sm\">\n                      <CheckCircle2 className=\"w-4 h-4 text-emerald-700\" />\n                      <span>SUDAH TERLAKSANA</span>\n                    </span>\n                  ) : (\n                    <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-blue-100 border-2 border-blue-500 text-blue-950 font-extrabold text-xs sm:text-sm\">\n                      <Clock className=\"w-4 h-4 text-blue-700\" />\n                      <span>AKAN DATANG</span>\n                    </span>\n                  )}\n                </div>\n              </div>\n\n              {/* Topik Pelajaran */}\n              <div className=\"mt-3.5\">\n                <span className=\"text-xs font-bold text-slate-500 uppercase tracking-wider block\">\n                  Topik Pelajaran:\n                </span>\n                <h4 className=\"text-xl sm:text-2xl font-black text-slate-900 mt-0.5 leading-snug\">\n                  {item.topic}\n                </h4>\n              </div>\n\n              {/* Tujuan Singkat (1 Kalimat) */}\n              <div className=\"mt-3 p-3.5 bg-slate-50 rounded-xl border border-slate-200\">\n                <div className=\"flex items-start gap-2.5\">\n                  <Target className=\"w-5 h-5 text-indigo-700 shrink-0 mt-0.5\" />\n                  <div>\n                    <span className=\"text-xs font-extrabold text-indigo-900 block\">\n                      Tujuan Belajar:\n                    </span>\n                    <p className=\"text-sm sm:text-base text-slate-800 font-semibold mt-0.5 leading-relaxed\">\n                      {item.objective}\n                    </p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 98
    num_bytes: 4179
    line_range_bytes: 4179
  }
}
