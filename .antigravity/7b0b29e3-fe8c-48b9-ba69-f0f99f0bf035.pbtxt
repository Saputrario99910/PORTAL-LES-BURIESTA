      thinking_signature: "\022\243\026\n\240\026\001i\024}\023\305,\f\347\356\tu\370\271\243L\245\032\236\033\251\207\245\316\r\002\312W\305(\026H\337\244\2703\034\355\252s\326-\371K\"&\274\346\'S\242\334\2268W\006\026\351\271\bo\201\216mr\\\264\360r\227O\2768/\247\335y\214\177v\3755\330\365\032\254]\266\244g6\312_\325\r}L\276-\343\323\207\272}\266\021\207g \354y\207?\216\033\257\251\321\'\316\257s\023\350\207Y>f-\306S\312\270r7f\033M\353\036\274<\276\n\362C\266\255\3117+\261\n\253\361\223kd\357\246t\313\223r\311\327B\311\2425E_\240\350\036\r2\005\372\263\265e\246=a\277\027XxJm\206\323\355\260\354\311\311\367\006\242\374\315?\304V\034nj#\331\212\025G\346\321qL\217W=7J\217\213\352\312\bI\306\334B\004\355\352\025\021IYL\031\320\306\310\231dg\210\0221\317\243\n\306A\354uZ\263\235\257y\005\363\251\a\v\375\221A\313]4\341\331c\217\252\333^\244\001\314v\232\307\334\022V\214\3517!\374\273\001\025\006\343\257|\260y\026\373;\232\336o>\331)4#\305\210\322\303\234\217\350\023\371<\367\203k\2118\273L\356\256)\372y\025\343%\f\257v\360\003\262\206GG=\234fP\375\033\030\\\215^\224\256\020\363\332_K\a\214\"\273F\356\"\255\253\371|\202%?\245\025\2543\350/\004\334MzQO\221\203k\325\247\347\000k\364nF\003w\266\305i\201\252\314\240\237\304\254\366\254E=\\\257b\n2\354lt<Tq\312\315\243\227()\361\311T>\0352\005~\002\265\020\227N\370\205\267\355\213\001Z\t\2225\b\260\302\215*\305\361\320\226\211\315\r\276y\305\220\342\b\324\315D~\267\001\355\004\360E\"\307\331\314-8\365\375F\203\235!\345\243a\'d\341+tEl\036\375\230\364J\262;\324*\tgG\"\244\302n\211~\3314\310(\355R\205\326]s\351=\001\327/\240u\355\250G\314\230\320Z\213!\335\021\002\265\027J}\363\254\366\325\003s\325\274wLs\fp\272%\257\373\374\355&\317|\336\215^\370\233\366\310\335\315\277\006\2536@V\247\354\020\217\270m\036f\225\374\373W\fTu\2133Cj\337\300Sh\035\370\365\363\336\330\320\272-\225\274Qm\326\251\020<\3370\n\205g\302\345\a\257\3655\202|W\aTY\371\023\320\351\026\342|\235p\206\'l\0217\244R\272\206\237\r\341\221W\322\240\036\246\270\0